generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String             @id @default(uuid())
  email              String             @unique
  username           String             @unique
  password           String
  firstName          String
  lastName           String
  phone              String?
  university         String?
  faculty            String?
  department         String?
  year               String?
  avatarUrl          String?
  employmentStatus   EmploymentStatus   @default(ACTIVE)
  isActive           Boolean            @default(true)
  /// Self-kayıt yöneticiden onay bekliyor mu?
  registrationStatus RegistrationStatus @default(APPROVED)
  approvedAt         DateTime?
  approvedById       String?
  approvedBy         User?              @relation("AccountApproval", fields: [approvedById], references: [id], onDelete: SetNull)
  accountsApproved   User[]             @relation("AccountApproval")
  /// Pasif üye: yalnızca /deactive ve sınırlı API
  portalDeactivated    Boolean          @default(false)
  deletedAt            DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  uiPreferences      Json?

  roles             UserRole[]
  refreshTokens     RefreshToken[]
  member            Member?
  auditLogs         AuditLog[]
  eventAttendees    EventAttendee[]
  meetingAttendees  MeetingAttendee[]

  @@index([registrationStatus])
  @@index([portalDeactivated])
  @@index([deletedAt])
  @@map("users")
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

/// Granular RBAC: key is stable API identifier (e.g. member.view, role.update).
model Permission {
  id          String           @id @default(uuid())
  key         String           @unique
  description String?
  category    String
  createdAt   DateTime         @default(now())

  roles RolePermission[]

  @@index([category])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  familyId  String
  expiresAt DateTime
  createdAt DateTime @default(now())
  isRevoked Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, familyId])
  @@map("refresh_tokens")
}

model Club {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  category    String?
  logoUrl     String?
  isActive    Boolean   @default(true)
  foundedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  members   Member[]
  events    Event[]
  meetings  Meeting[]

  @@map("clubs")
}

model Member {
  id         String       @id @default(uuid())
  userId     String       @unique
  clubId     String
  status     MemberStatus @default(pending)
  role       String       @default("uye")
  joinedAt   DateTime     @default(now())
  approvedAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@map("members")
}

model EventCategory {
  id          String    @id @default(uuid())
  name        String
  description String?
  color       String?
  sortOrder   Int       @default(0)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  events Event[]

  @@index([deletedAt])
  @@map("event_categories")
}

/// Katılım durumu şablonları — scope ile etkinlik / toplantı ayrılır
model ParticipationStatus {
  id          String                @id @default(uuid())
  scope       ParticipationScope
  label       String
  color       String?
  fontWeight  String?
  fontStyle   String?
  sortOrder   Int                   @default(0)
  deletedAt   DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  eventAttendees    EventAttendee[]
  meetingAttendees  MeetingAttendee[]

  @@index([scope, deletedAt])
  @@map("participation_statuses")
}

model Event {
  id                 String    @id @default(uuid())
  title              String
  description        String?
  location           String?
  startDate          DateTime?
  endDate            DateTime?
  startUndetermined  Boolean   @default(false)
  endUndetermined    Boolean   @default(false)
  capacity           Int?
  isPublic           Boolean   @default(true)
  clubId             String
  categoryId         String?
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  club       Club           @relation(fields: [clubId], references: [id], onDelete: Cascade)
  category   EventCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  attendees  EventAttendee[]

  @@index([clubId, deletedAt])
  @@index([categoryId])
  @@map("events")
}

model EventAttendee {
  id                      String   @id @default(uuid())
  eventId                 String
  userId                  String
  participationStatusId String?
  joinedAt                DateTime @default(now())
  deletedAt               DateTime?

  event                 Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  participationStatus   ParticipationStatus? @relation(fields: [participationStatusId], references: [id], onDelete: SetNull)

  @@unique([eventId, userId])
  @@index([participationStatusId])
  @@map("event_attendees")
}

model MeetingCategory {
  id          String    @id @default(uuid())
  name        String
  color       String?
  sortOrder   Int       @default(0)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  meetings Meeting[]

  @@map("meeting_categories")
}

model Meeting {
  id                 String    @id @default(uuid())
  title              String
  description        String?
  location           String?
  startDate          DateTime?
  endDate            DateTime?
  startUndetermined  Boolean   @default(false)
  endUndetermined    Boolean   @default(false)
  clubId             String
  categoryId         String?
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  club         Club              @relation(fields: [clubId], references: [id], onDelete: Cascade)
  category     MeetingCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  attendees    MeetingAttendee[]

  @@index([clubId, deletedAt])
  @@map("meetings")
}

model MeetingAttendee {
  id                      String   @id @default(uuid())
  meetingId               String
  userId                  String
  participationStatusId String?
  joinedAt                DateTime @default(now())
  deletedAt               DateTime?

  meeting               Meeting                @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  participationStatus   ParticipationStatus? @relation(fields: [participationStatusId], references: [id], onDelete: SetNull)

  @@unique([meetingId, userId])
  @@map("meeting_attendees")
}

model Announcement {
  id        String    @id @default(uuid())
  title     String
  content   String
  clubId    String?
  isGlobal  Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([deletedAt])
  @@map("announcements")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  PROBATION
  TERMINATED
}

enum MemberStatus {
  pending
  approved
  rejected
  suspended
}

enum RegistrationStatus {
  PENDING
  APPROVED
}

enum ParticipationScope {
  EVENT
  MEETING
}
